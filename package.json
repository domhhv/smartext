{
  "name": "smartext",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-powered rich-text editor assistant that helps you write better content.",
  "keywords": [
    "ai",
    "assistant",
    "editor",
    "nextjs",
    "react",
    "tailwindcss",
    "typescript",
    "lexical",
    "radix-ui",
    "shadcn",
    "openai",
    "sentry",
    "posthog",
    "vercel"
  ],
  "homepage": "https://smartext.app",
  "bugs": {
    "url": "https://github.com/domhhv/smartext/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/domhhv/smartext.git"
  },
  "license": "MIT",
  "author": {
    "name": "Dominik Hryshaiev",
    "email": "domhryshaiev@gmail.com",
    "url": "https://domhhv.com"
  },
  "scripts": {
    "analyze": "next experimental-analyze",
    "prebuild": "npm run typecheck && npm run eslint:check && npm run prettier:check",
    "build": "TURBOPACK_STATS=1 next build",
    "build:webpack": "next build --webpack",
    "bundle:compare": "node scripts/compare-bundle.mjs",
    "bundle:measure": "node scripts/measure-bundle.mjs",
    "db:diff": "supabase db diff",
    "db:diff:storage": "supabase db diff --schema storage",
    "db:gen-types": "supabase gen types --lang=typescript --schema public --schema auth --schema storage --local > supabase/database.types.ts && node scripts/patch-json-type.mjs && eslint --fix supabase/database.types.ts",
    "db:migration:new": "supabase migration new",
    "db:migration:up": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:restart": "npm run db:stop && npm run db:start",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "dev": "next dev",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint --fix .",
    "fix:sql": "node scripts/sqlfluff.mjs fix",
    "lint:sql": "node scripts/sqlfluff.mjs lint",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "sort-package-json:check": "sort-package-json --check",
    "sort-package-json:write": "sort-package-json",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/openai": "^4.0.7",
    "@ai-sdk/react": "^4.0.16",
    "@clerk/nextjs": "^7.5.12",
    "@clerk/themes": "^2.4.57",
    "@hookform/resolvers": "^5.4.0",
    "@lexical/react": "^0.46.0",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.15",
    "camelcase-keys": "^10.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color": "^5.0.3",
    "colorjs.io": "^0.6.1",
    "crypto-js": "^4.2.0",
    "decamelize-keys": "^2.0.1",
    "lexical": "^0.46.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.23.0",
    "nanoid": "^5.1.16",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.396.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-resizable-panels": "^4.12.1",
    "react-swipeable": "^7.0.2",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "type-fest": "^5.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bundle-stats/plugin-webpack-filter": "^4.22.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.4",
    "@eslint/markdown": "^8.0.3",
    "@lexical/eslint-plugin": "^0.46.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/webpack-stats-plugin": "^0.3.5",
    "baseline-browser-mapping": "^2.10.42",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-switch-case": "^4.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass": "^1.101.0",
    "sort-package-json": "^4.0.0",
    "supabase": "^2.109.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "webpack-stats-plugin": "^1.1.3"
  },
  "engines": {
    "node": "^24.18.0",
    "npm": "^11.16.0"
  },
  "nextBundleAnalysis": {
    "budget": null,
    "budgetPercentIncreaseRed": 20,
    "minimumChangeThreshold": 0,
    "showDetails": true
  }
}
